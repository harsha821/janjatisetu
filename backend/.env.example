# Copy this file to backend/.env and fill in real values before deploying.
# Everything here has a safe local-dev default in app/config.py.

APP_NAME=JanjatiSetu

# --- security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Fernet key for encrypting bank account numbers at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- database -----------------------------------------------------------------
# Local dev (SQLite, no setup needed):
DATABASE_URL=sqlite:///./janjatisetu.db
# Docker / production (PostgreSQL + PostGIS, see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://janjatisetu:janjatisetu@db:5432/janjatisetu

# --- CORS -----------------------------------------------------------------------
# Comma-separated list of allowed origins, or * for all (dev only).
CORS_ORIGINS=*

# --- seed / demo data ---------------------------------------------------------
# Loads the 4 demo students, verifier and ministry admin from seed.py.
# ALWAYS set this to false before any real deployment.
SEED_DEMO=true

# --- uploads --------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- integration gateway ------------------------------------------------------
# mock  -> every government source is answered from the local database (default)
# live  -> calls LIVE_ENDPOINTS via OAuth2 client-credentials + mutual TLS
INTEGRATION_MODE=mock
# Comma-separated source names to simulate as down in mock mode, e.g. UIDAI,NSP
SIMULATE_OUTAGES=

# Required only when INTEGRATION_MODE=live, after data-sharing agreements are signed:
GATEWAY_TOKEN_URL=
GATEWAY_CLIENT_ID=
GATEWAY_CLIENT_SECRET=
MTLS_CERT=
MTLS_KEY=
MTLS_CA=
# JSON object mapping source name -> base URL, e.g. {"UIDAI":"https://uidai.example.gov.in/api"}
LIVE_ENDPOINTS_JSON={}

# --- notifications --------------------------------------------------------------
FCM_ENABLED=false
FCM_CREDENTIALS_FILE=
SMS_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=JNJSTU

# --- DigiLocker Sandbox OAuth2 --------------------------------------------------
# Register at https://sandbox.digilocker.gov.in to get sandbox credentials.
# Leave blank to keep mock mode (no real DigiLocker calls will be made).
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# The callback URL registered in the DigiLocker sandbox developer console:
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/v1/wallet/digilocker/callback
# true  → sandbox.digilocker.gov.in  (default for development)
# false → api.digilocker.gov.in      (production)
DIGILOCKER_SANDBOX=true
